{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBA Live Scoreboard",
  "version": "0.1.0",
  "identifier": "com.nbalivescoreboard.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NBA Live Scoreboard",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0d111b",
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../icon.ico"]
  }
}
